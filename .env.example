# Image tag: latest, a version such as 5.6.0, or sha-<commit>
RTTYS_VERSION=latest

# Container time zone, used in log timestamps
TZ=UTC

# Log level: debug, info, warn, error
RTTYS_LOG_LEVEL=info

# Web management password (required)
RTTYS_PASSWORD=change-me

# Token that devices must present (rtty -t); leave empty to allow any device
RTTYS_TOKEN=

# Allow cross-origin requests to the API: true or false
RTTYS_ALLOW_ORIGINS=false

# Host ports for device connections and the web UI
RTTYS_DEV_PORT=5912
RTTYS_WEB_PORT=5913

# Device web proxy port, published on the same port on the host
RTTYS_HTTP_PROXY_PORT=5914

# Redirect device web proxy to this URL instead of <host>:<proxy port>,
# e.g. when it sits behind a reverse proxy
RTTYS_HTTP_PROXY_REDIR_URL=

# Domain used for the device web proxy cookie
RTTYS_HTTP_PROXY_REDIR_DOMAIN=

# Hostname or IP shown in share connection details
RTTYS_SHARE_PUBLIC_HOST=

# Port range for temporary SSH/TCP shares, published as-is on the host
RTTYS_SHARE_PORT_START=20000
RTTYS_SHARE_PORT_END=20099

# Hooks (see deploy/rttys.conf). Use host.docker.internal to reach the host.
RTTYS_DEV_HOOK_URL=
RTTYS_USER_HOOK_URL=

# TLS for device connections. Put files in RTTYS_CERT_DIR and reference them
# by their path in the container, e.g. /etc/rttys/certs/server.crt
RTTYS_CERT_DIR=./certs
RTTYS_SSL_CERT=
RTTYS_SSL_KEY=
RTTYS_CA_CERT=
